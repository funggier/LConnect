{
  "fullMachineAccess": true,
  "allowedDirectories": [
    ".."
  ],
  "shell": {
    "enabled": true,
    "maxOutputChars": 120000,
    "defaultTimeoutSeconds": 60,
    "maxTimeoutSeconds": 600
  },
  "process": {
    "maxBufferedOutputChars": 240000
  },
  "mcp": {
    "maxSynchronousRequestSeconds": 15
  },
  "telemetry": {
    "enabled": true,
    "maxEvents": 500
  }
}
